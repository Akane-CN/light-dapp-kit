{
  "name": "light-dapp-kit",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "bun run --filter './packages/*' test",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "dev:wallet": "bun run --cwd apps/light-wallet dev",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@ckb-ccc/core": "^1.23.0",
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "bun@1.4.4"
}
